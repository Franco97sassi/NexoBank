# Configuracion del entorno local de Docker Compose.
POSTGRES_DB=nexobank
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5434
BACKEND_PORT=8080
FRONTEND_PORT=5173
JWT_SECRET=change-this-development-secret-with-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173
REFRESH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
